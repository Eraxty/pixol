# --- Slack (api.slack.com → your app → Basic Info) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# --- brain ---
# Local Ollama (default). Point at any OpenAI-compatible endpoint instead.
# NOTE: thinking models (qwen3, deepseek-r1) burn prompt budget on reasoning —
# LLM_MAX_TOKENS must stay well above your longest answer.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama
LLM_MAX_TOKENS=4000

# --- behaviour ---
BOT_NAME=pixol
BOT_KEYWORDS=pixol
MAX_HISTORY=16
SEARCH_LIMIT=5
PAGE_TEXT_LIMIT=6000
SHOT_MAX_H=2600

# --- owner (your Slack member ID) ---
OWNER_ID=U0XXXXXXX
OWNER_NAME=you
# optional reasoning model for real questions (math/code); banter uses LLM_MODEL
LLM_SMART_MODEL=
OWNER_PRONOUNS=they/them
